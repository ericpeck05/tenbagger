# Copy this file to .env and fill in the values. Never commit .env.

# Free key from finnhub.io
FINNHUB_API_KEY=

# Free market data keys from alpaca.markets
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# SEC EDGAR requires a name and contact email on every request,
# for example: Tenbagger you@example.com
SEC_USER_AGENT=
